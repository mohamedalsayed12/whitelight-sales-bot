# Local development only. Copy this file to .env. Never commit .env.

DATABASE_URL=postgresql+psycopg://whitelight:whitelight@localhost:5432/whitelight
TEST_DATABASE_URL=postgresql+psycopg://whitelight:whitelight@localhost:5432/whitelight_test

# Used to sign login tokens. Use a long random string outside local development.
# HMAC-SHA256 wants at least 32 characters.
JWT_SECRET=local-dev-only-change-this-secret-key
# 480 minutes is one working day.
JWT_EXPIRE_MINUTES=480

# Created once on startup if this email does not already exist.
# Leave both blank to skip. The password must be 8 to 72 characters.
ADMIN_EMAIL=ceo@example.com
ADMIN_PASSWORD=change-me-please
ADMIN_FULL_NAME=White Light Admin
